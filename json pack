import React, { useEffect, useRef, useState } from 'react';
import { View, Text, StyleSheet, Dimensions, Animated } from 'react-native';
import Svg, { Circle, Line, G } from 'react-native-svg';
import * as Haptics from 'expo-haptics';
import { useAudio } from '../context/AudioContext';
import { useGame } from '../context/GameContext';

const { width, height } = Dimensions.get('window');
const PLAYER_SIZE = 40;

export default function GameScreen({ onGameOver }) {
  const { volume, startListening, stopListening } = useAudio();
  const { state, dispatch } = useGame();
  const [shockwave, setShockwave] = useState(null);
  const [playerPos, setPlayerPos] = useState({ x: width / 2, y: height - 150 });
  const spawnTimer = useRef(0);
  const lastVolume = useRef(0);

  // Start listening on mount
  useEffect(() => {
    startListening();
    return () => stopListening();
  }, []);

  // Voice → Action mapping
  useEffect(() => {
    if (volume > 60) {
      // SHOUT = Shockwave attack
      triggerShockwave(volume);
      Haptics.impactAsync(Haptics.ImpactFeedbackStyle.Heavy);
    } else if (volume > 20 && volume < 40) {
      // WHISPER = Heal
      dispatch({ type: 'HEAL', payload: 0.2 });
    }
    lastVolume.current = volume;
  }, [volume]);

  const triggerShockwave = (power) => {
    const sw = {
      id: Date.now(),
      x: playerPos.x,
      y: playerPos.y,
      radius: 0,
      power,
    };
    setShockwave(sw);

    // Damage enemies in range
    state.enemies.forEach(enemy => {
      const dist = Math.hypot(enemy.x - playerPos.x, enemy.y - playerPos.y);
      if (dist < 200) {
        dispatch({ type: 'REMOVE_ENEMY', payload: enemy.id });
        dispatch({ type: 'ADD_SCORE', payload: 100 });
        Haptics.notificationAsync(Haptics.NotificationFeedbackType.Success);
      }
    });

    // Animate shockwave
    let r = 0;
    const anim = setInterval(() => {
      r += 15;
      setShockwave(prev => prev ? { ...prev, radius: r } : null);
      if (r > 400) {
        clearInterval(anim);
        setShockwave(null);
      }
    }, 16);
  };

  // Enemy spawning
  useEffect(() => {
    const interval = setInterval(() => {
      dispatch({
        type: 'SPAWN_ENEMY',
        payload: {
          id: Date.now() + Math.random(),
          x: Math.random() * (width - 60) + 30,
          y: -30,
          speed: 1 + Math.random() * 2 + state.level * 0.3,
          hp: 1,
        },
      });
    }, Math.max(800, 2000 - state.level * 100));
    return () => clearInterval(interval);
  }, [state.level]);

  // Move enemies + collision detection
  useEffect(() => {
    const frame = setInterval(() => {
      state.enemies.forEach(enemy => {
        enemy.y += enemy.speed;
        if (enemy.y > height) {
          dispatch({ type: 'REMOVE_ENEMY', payload: enemy.id });
          dispatch({ type: 'DAMAGE', payload: 10 });
          Haptics.impactAsync(Haptics.ImpactFeedbackStyle.Light);
        }
        // Collision with player
        if (Math.hypot(enemy.x - playerPos.x, enemy.y - playerPos.y) < 40) {
          dispatch({ type: 'REMOVE_ENEMY', payload: enemy.id });
          dispatch({ type: 'DAMAGE', payload: 15 });
        }
      });
    }, 16);
    return () => clearInterval(frame);
  }, [state.enemies, playerPos]);

  // Player movement via touch (position follows finger x)
  const handleTouch = (e) => {
    const x = e.nativeEvent.locationX;
    setPlayerPos(prev => ({ ...prev, x: Math.max(30, Math.min(width - 30, x)) }));
  };

  // Game over
  useEffect(() => {
    if (state.health <= 0) onGameOver(state.score);
  }, [state.health]);

  // Level up
  useEffect(() => {
    const newLevel = Math.floor(state.score / 1000) + 1;
    if (newLevel !== state.level) {
      // Trigger level up effect
    }
  }, [state.score]);

  const volumeColor = volume > 60 ? '#ef4444' : volume > 20 ? '#22c55e' : '#3b82f6';

  return (
    <View 
      style={styles.container}
      onStartShouldSetResponder={() => true}
      onResponderMove={handleTouch}
      onResponderGrant={handleTouch}
    >
      {/* Starfield background */}
      <Svg height={height} width={width} style={StyleSheet.absoluteFill}>
        {Array.from({ length: 60 }).map((_, i) => (
          <Circle
            key={i}
            cx={(i * 137.5) % width}
            cy={(i * 73.3) % height}
            r={1 + (i % 3) * 0.5}
            fill="#fff"
            opacity={0.3 + (i % 5) * 0.1}
          />
        ))}
      </Svg>

      {/* HUD */}
      <View style={styles.hud}>
        <View style={styles.healthBar}>
          <View style={[styles.healthFill, { width: `${state.health}%` }]} />
        </View>
        <Text style={styles.score}>⚡ {state.score}</Text>
        <Text style={styles.level}>LV {state.level}</Text>
      </View>

      {/* Volume meter */}
      <View style={styles.volumeMeter}>
        <View style={[styles.volumeFill, { width: `${volume}%`, backgroundColor: volumeColor }]} />
        <Text style={styles.volumeLabel}>
          {volume > 60 ? '🔥 SHOUT!' : volume > 20 ? '💚 WHISPER' : '🎤 SPEAK'}
        </Text>
      </View>

      {/* Enemies */}
      <Svg height={height} width={width} style={StyleSheet.absoluteFill}>
        {state.enemies.map(enemy => (
          <G key={enemy.id}>
            <Circle cx={enemy.x} cy={enemy.y} r={25} fill="#ef4444" opacity={0.4} />
            <Circle cx={enemy.x} cy={enemy.y} r={18} fill="#dc2626" />
            <Circle cx={enemy.x} cy={enemy.y} r={8} fill="#7f1d1d" />
            <Circle cx={enemy.x - 5} cy={enemy.y - 3} r={3} fill="#fff" />
            <Circle cx={enemy.x + 5} cy={enemy.y - 3} r={3} fill="#fff" />
          </G>
        ))}

        {/* Player */}
        <G>
          <Circle cx={playerPos.x} cy={playerPos.y} r={30} fill="#7c3aed" opacity={0.3} />
          <Circle cx={playerPos.x} cy={playerPos.y} r={20} fill="#a78bfa" />
          <Circle cx={playerPos.x} cy={playerPos.y} r={10} fill="#fff" />
        </G>

        {/* Shockwave */}
        {shockwave && (
          <>
            <Circle
              cx={shockwave.x}
              cy={shockwave.y}
              r={shockwave.radius}
              stroke="#7c3aed"
              strokeWidth={4}
              fill="none"
              opacity={Math.max(0, 1 - shockwave.radius / 400)}
            />
            <Circle
              cx={shockwave.x}
              cy={shockwave.y}
              r={shockwave.radius * 0.7}
              stroke="#a78bfa"
              strokeWidth={2}
              fill="none"
              opacity={Math.max(0, 1 - shockwave.radius / 400)}
            />
          </>
        )}
      </Svg>
    </View>
  );
}

