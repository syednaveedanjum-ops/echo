import React, { createContext, useContext, useEffect, useRef, useState } from 'react';
import { Audio } from 'expo-av';

const AudioContext = createContext();

export const useAudio = () => useContext(AudioContext);

export const AudioProvider = ({ children }) => {
  const [volume, setVolume] = useState(0);
  const [isRecording, setIsRecording] = useState(false);
  const recordingRef = useRef(null);

  const startListening = async () => {
    try {
      const { status } = await Audio.requestPermissionsAsync();
      if (status !== 'granted') return;

      await Audio.setAudioModeAsync({
        allowsRecordingIOS: true,
        playsInSilentModeIOS: true,
      });

      const { recording } = await Audio.Recording.createAsync(
        Audio.RecordingOptionsPresets.HIGH_QUALITY,
        (status) => {
          // Metering gives us volume in dB (-160 to 0)
          if (status.metering !== undefined) {
            // Convert dB to 0-100 scale
            const normalized = Math.max(0, Math.min(100, (status.metering + 60) * 1.67));
            setVolume(normalized);
          }
        },
        100
      );
      recordingRef.current = recording;
      setIsRecording(true);
    } catch (err) {
      console.error('Recording error:', err);
    }
  };

  const stopListening = async () => {
    if (recordingRef.current) {
      await recordingRef.current.stopAndUnloadAsync();
      recordingRef.current = null;
      setIsRecording(false);
      setVolume(0);
    }
  };

  useEffect(() => {
    return () => { stopListening(); };
  }, []);

  return (
    <AudioContext.Provider value={{ 
      volume, 
      isRecording, 
      startListening, 
      stopListening 
    }}>
      {children}
    </AudioContext.Provider>
  );
};
import React, { createContext, useContext, useReducer, useEffect } from 'react';

const GameContext = createContext();
export const useGame = () => useContext(GameContext);

const initialState = {
  health: 100,
  energy: 100,
  score: 0,
  level: 1,
  enemies: [],
  particles: [],
  combo: 0,
  time: 0,
};

function reducer(state, action) {
  switch (action.type) {
    case 'TICK':
      return { ...state, time: state.time + 1 };
    case 'DAMAGE':
      return { ...state, health: Math.max(0, state.health - action.payload) };
    case 'HEAL':
      return { ...state, health: Math.min(100, state.health + action.payload) };
    case 'ADD_SCORE':
      return { ...state, score: state.score + action.payload, combo: state.combo + 1 };
    case 'SPAWN_ENEMY':
      return { ...state, enemies: [...state.enemies, action.payload] };
    case 'REMOVE_ENEMY':
      return { ...state, enemies: state.enemies.filter(e => e.id !== action.payload) };
    case 'RESET':
      return initialState;
    default:
      return state;
  }
}

export const GameProvider = ({ children }) => {
  const [state, dispatch] = useReducer(reducer, initialState);

  // Game loop - 60 FPS tick
  useEffect(() => {
    const interval = setInterval(() => dispatch({ type: 'TICK' }), 1000 / 60);
    return () => clearInterval(interval);
  }, []);

  return (
    <GameContext.Provider value={{ state, dispatch }}>
      {children}
    </GameContext.Provider>
  );
};
